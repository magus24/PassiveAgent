# ==========================================
# PassiveAgent .gitignore
# ==========================================

# --- Environments & Secrets (CRITICAL FOR SECURITY) ---
.env
.env.*
!.env.example
*.env
backend/.env
backend/.env.*
!backend/.env.example
*.key
*.pem
*.cert
*.crt
*.pfx
*.p12

# --- Telegram Sessions (CRITICAL: MTProto Auth Keys) ---
*.session
*.session-journal
backend/*.session
backend/*.session-journal

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
*/venv/
*/.venv/
backend/.venv/
env/
ENV/

# --- Large ML Models & Weights (>100MB cannot be pushed to GitHub) ---
*.bin
*.pt
*.pth
*.safetensors
*.onnx
backend/ai/pytorch_model.bin

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.local

# --- Databases & Local Storage ---
*.sqlite
*.sqlite3
*.db
*.db-journal
spiderfoot.db

# --- Logs ---
*.log
logs/

# --- IDE & OS metadata ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
