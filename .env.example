# ==========================================
# PassiveAgent Environment Configuration Template
# Copy this file to `backend/.env` and fill in your values:
#   cp .env.example backend/.env
# ==========================================

# --- Telegram API Credentials (https://my.telegram.org) ---
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_PHONE_NUMBER=+1234567890

# --- PostgreSQL with pgvector (matches docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=passiveagent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Neo4j Graph Database (matches docker-compose.yml) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- SpiderFoot OSINT Service ---
SPIDERFOOT_HOST=127.0.0.1
SPIDERFOOT_PORT=5001

# --- Backend API Service ---
API_HOST=127.0.0.1
API_PORT=18080

# --- AI Intelligence Provider (Groq Cloud LLM) ---
AI_PROVIDER=groq
AI_ENABLED=true
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=800
GROQ_TIMEOUT=30
AI_DAILY_LIMIT=300
AI_PER_MINUTE_LIMIT=5
AI_MIN_LOCAL_SCORE=0.35
AI_ANALYZE_ONLY_CANDIDATES=true
